{
  "name": "raffle-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static frontend for the Raffle (RAFL) / CommitRevealRaffle launch on Sepolia.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && node scripts/emit-deployment.mjs",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.103.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.8",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
